# Generate a random value of at least 32 characters. Never commit the real value.
AI_CORE_API_KEY=replace-with-a-long-random-secret

# OpenAI-compatible inference and embedding endpoint, e.g. https://provider.example/v1
AI_CORE_MODEL_BASE_URL=
AI_CORE_MODEL_API_KEY=
AI_CORE_MODEL=
AI_CORE_EMBEDDING_MODEL=

# PostgreSQL with the pgvector extension enabled
DATABASE_URL=
DATABASE_SSL=false

# REA launches as a local stdio child process. Do not expose a public MCP listener.
REA_MCP_COMMAND=npx
REA_MCP_ARGS_JSON=["-y","rea-agents","mcp"]

# Inference controls. Support varies by model provider.
AI_CORE_TEMPERATURE=0.2
AI_CORE_TOP_P=0.95
AI_CORE_TOP_K=
AI_CORE_FREQUENCY_PENALTY=0
AI_CORE_PRESENCE_PENALTY=0
AI_CORE_REASONING_EFFORT=
AI_CORE_MAX_TOKENS=8192
AI_CORE_MAX_TOOL_ROUNDS=8
AI_CORE_REQUEST_TIMEOUT_MS=120000
AI_CORE_MAX_REQUEST_BYTES=2000000
AI_CORE_PORT=8787
