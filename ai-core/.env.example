# Generate a random value of at least 32 characters. Never commit the real value.
AI_CORE_API_KEY=replace-with-a-long-random-secret

# OpenAI-compatible inference endpoint, e.g. https://provider.example/v1
AI_CORE_MODEL_BASE_URL=
AI_CORE_MODEL_API_KEY=
AI_CORE_MODEL=

# REA HTTP MCP must run in the same trusted host/container and bind to loopback only.
# Start it with: rea mcp --http --host 127.0.0.1 --port 8765
REA_MCP_URL=http://127.0.0.1:8765/mcp

# Reasoning / inference controls. Provider support varies.
AI_CORE_TEMPERATURE=0.2
AI_CORE_TOP_P=0.95
AI_CORE_MAX_TOKENS=8192
AI_CORE_MAX_TOOL_ROUNDS=8
AI_CORE_REQUEST_TIMEOUT_MS=120000
AI_CORE_MAX_REQUEST_BYTES=2000000
AI_CORE_PORT=8787
