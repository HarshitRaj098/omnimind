# Local-first chat: no Gemini/Claude API key is required for chat.
# Run Ollama on the same machine/network as the OmniMind backend.
AI_PROVIDER="local"
AI_COMPATIBLE_BASE_URL="http://127.0.0.1:11434/v1"
AI_COMPATIBLE_MODEL="qwen2.5:3b"
# Leave AI_COMPATIBLE_API_KEY empty for local Ollama.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth 2.0 (create a Web application OAuth client in Google Cloud Console).
# Add https://YOUR_APP_URL/api/apps/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; otherwise APP_URL + /api/apps/google/callback is used.
GOOGLE_REDIRECT_URI=""

# GitHub OAuth App (create an OAuth App in GitHub Developer Settings).
# Add https://YOUR_APP_URL/api/apps/github/callback as the callback URL.
# This integration requests profile access only and lists public repositories.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional override; otherwise APP_URL + /api/apps/github/callback is used.
GITHUB_REDIRECT_URI=""

# For a remote Ollama host, replace the local URL above with a private,
# authenticated HTTPS endpoint reachable from the backend. Do not expose Ollama
# directly to the public internet. Vercel cannot reach your own localhost.
