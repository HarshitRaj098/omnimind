# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google OAuth 2.0 (create a Web application OAuth client in Google Cloud Console).
# Add https://YOUR_APP_URL/api/apps/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional override; otherwise APP_URL + /api/apps/google/callback is used.
GOOGLE_REDIRECT_URI=""

# GitHub OAuth App (create an OAuth App in GitHub Developer Settings).
# Add https://YOUR_APP_URL/api/apps/github/callback as the callback URL.
# This integration requests profile access only and lists public repositories.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
# Optional override; otherwise APP_URL + /api/apps/github/callback is used.
GITHUB_REDIRECT_URI=""

# Optional OpenAI-compatible inference fallback. Configure an Ollama or
# llama.cpp server reachable FROM THE OmniMind backend. For Ollama, the base
# URL commonly ends in /v1 (for example http://127.0.0.1:11434/v1).
# This fallback is attempted when Gemini reports quota exhaustion or a missing model.
# A Vercel deployment cannot reach Ollama running on your phone/PC via 127.0.0.1;
# use a securely reachable server URL or run OmniMind and Ollama on the same host.
AI_COMPATIBLE_BASE_URL=""
AI_COMPATIBLE_MODEL=""
AI_COMPATIBLE_API_KEY=""

# Optional REA-powered AI Core service. When set, Agent Mode routes through REA.
# Keep the API key server-side only; never expose it to Vite/client variables.
AI_CORE_URL=""
AI_CORE_API_KEY=""
